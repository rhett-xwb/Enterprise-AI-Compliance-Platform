# Template only. Use independent local secrets; never commit the filled .env.
DB_USERNAME=compliance_app
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3306
# For a local non-TLS MySQL test instance only. Use TLS in a real deployment.
DB_URL=jdbc:mysql://127.0.0.1:3306/compliance_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
BOOTSTRAP_ENABLED=false
BOOTSTRAP_USERNAME=bootstrap-admin
BOOTSTRAP_PASSWORD=
# Base64 encoded random key, at least 32 bytes; generate locally, no default secret.
JWT_SECRET=
JWT_TTL_SECONDS=900
# Explicit one-time empty-database admin creation. No password reset on restart.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# Persistent private file directory, relative to the Java working directory or absolute.
DOCUMENT_STORAGE_ROOT=data/documents
# Java and Python must share this private storage directory and a random parser secret.
PARSER_ENABLED=false
PARSER_URL=http://127.0.0.1:8090
PARSER_SECRET=
PARSER_CLIENT_TIMEOUT_SECONDS=190
PARSER_TIMEOUT_SECONDS=180
PARSER_MAX_PAGES=100
PARSER_CONCURRENCY=1
# Internal local Chinese embedding + persistent Qdrant. Separate secret from parser.
RETRIEVAL_ENABLED=false
RETRIEVAL_URL=http://127.0.0.1:8091
RETRIEVAL_SECRET=
VECTOR_STORAGE_ROOT=data/vectors
EMBEDDING_CACHE=.cache/embedding
# Optional generation provider. Full Chat Completions POST endpoint; remote HTTPS required.
QA_ENABLED=false
QA_COMPLETIONS_URL=
QA_MODEL=
QA_API_KEY=
QA_TIMEOUT_SECONDS=60
# 差旅申请金额上限（CNY）；0 关闭业务上限，正数由管理员核实后设置。
TRAVEL_MAXIMUM_AMOUNT=0
## Stage 10 (optional; defaults preserve stage 5/6 processing)
ASYNC_TASKS_ENABLED=false
ASYNC_TASK_POLL_MS=1000
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=compliance
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
SOURCE_CACHE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Unique per environment/database; never share across business and acceptance databases.
CACHE_NAMESPACE=compliance-dev
