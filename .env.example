# Template only. Use independent local secrets; never commit the filled .env.
DB_USERNAME=compliance_app
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3306
# For a local non-TLS MySQL test instance only. Use TLS in a real deployment.
DB_URL=jdbc:mysql://127.0.0.1:3306/compliance_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
BOOTSTRAP_ENABLED=false
BOOTSTRAP_USERNAME=bootstrap-admin
BOOTSTRAP_PASSWORD=
